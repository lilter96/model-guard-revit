<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <RevitTargetFramework Condition="'$(RevitVersion)' == '2025'">net8.0-windows</RevitTargetFramework>
    <RevitTargetFramework Condition="'$(RevitVersion)' != '2025'">net48</RevitTargetFramework>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2021'">2021.1.40</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2022'">2022.1.1</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2023'">2023.0.1</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2024'">2024.0.0</RevitApiVersion>
    <RevitApiVersion Condition="'$(RevitVersion)' == '2025'">2025.0.2</RevitApiVersion>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts/$(RevitVersion)/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts/obj/$(RevitVersion)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="ValidateRevitVersion" BeforeTargets="PrepareForBuild" Condition="'$(RevitApiVersion)' == ''">
    <Error Text="Supported RevitVersion values: 2021, 2022, 2023, 2024, 2025." />
  </Target>
</Project>
